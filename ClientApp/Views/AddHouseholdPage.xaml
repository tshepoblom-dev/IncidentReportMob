<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:ClientApp.Viewmodels"
             xmlns:converters="clr-namespace:ClientApp.Converters"
             x:DataType="viewmodel:AddHouseholdViewmodel"
             x:Class="ClientApp.Views.AddHouseholdPage"
             Title="Add Household"
             BackgroundColor="#F2F5F8">

    <ContentPage.Resources>
        <Color x:Key="PrimaryBlue">#2563EB</Color>
        <Color x:Key="AccentGreen">#16A34A</Color>
        <Color x:Key="DangerRed">#DC2626</Color>
        <Color x:Key="CardBackground">#FFFFFF</Color>

        <converters:StepToColorConverter x:Key="StepToColorConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <!-- Step Indicators -->
        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="10" Margin="0,8">
            <Ellipse WidthRequest="12" HeightRequest="12"
                     Fill="{Binding Step, Converter={StaticResource StepToColorConverter}, ConverterParameter=0}" />
            <Ellipse WidthRequest="12" HeightRequest="12"
                     Fill="{Binding Step, Converter={StaticResource StepToColorConverter}, ConverterParameter=1}" />
            <Ellipse WidthRequest="12" HeightRequest="12"
                     Fill="{Binding Step, Converter={StaticResource StepToColorConverter}, ConverterParameter=2}" />
            <Ellipse WidthRequest="12" HeightRequest="12"
                     Fill="{Binding Step, Converter={StaticResource StepToColorConverter}, ConverterParameter=3}" />
            <Ellipse WidthRequest="12" HeightRequest="12"
                     Fill="{Binding Step, Converter={StaticResource StepToColorConverter}, ConverterParameter=4}" />
        </StackLayout>

        <!-- Main Scrollable Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="10">

                <!-- STEP 1: Household Profile -->
                <Frame x:Name="Step1Frame"
                       IsVisible="{Binding IsStep1}"
                       CornerRadius="16"
                       BackgroundColor="{StaticResource CardBackground}"
                       HasShadow="True"
                       Padding="20">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Household Profile" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryBlue}" />
                        <Entry Placeholder="Head of Household Name" Text="{Binding HeadOfHouseholdName}" />
                        <Entry Placeholder="ID Number" Text="{Binding HeadOfHouseholdIdNumber}" Keyboard="Numeric" />
                        <Entry Placeholder="Phone Number" Text="{Binding PhoneNumber}" Keyboard="Telephone" />
                        <Entry Placeholder="Address" Text="{Binding Address}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- STEP 2: Members -->
                <Frame x:Name="Step2Frame"
                       IsVisible="{Binding IsStep2}"
                       CornerRadius="16"
                       BackgroundColor="{StaticResource CardBackground}"
                       HasShadow="True"
                       Padding="20">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Household Members" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryBlue}" />
                        <Button Text="➕ Add Member" Command="{Binding AddMemberCommand}" BackgroundColor="{StaticResource PrimaryBlue}" TextColor="White" />
                        <CollectionView ItemsSource="{Binding Members}" Margin="0,10,0,0">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Padding="10" Margin="0,5" BackgroundColor="#F9FAFB" CornerRadius="12">
                                        <VerticalStackLayout>
                                     <!--       <Label Text="{Binding HouseholdMember}" FontAttributes="Bold" />
                                            <Label Text="{Binding Relationship}" FontSize="12" TextColor="Gray" /> -->
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- STEP 3: Media -->
                <Frame x:Name="Step3Frame"
                       IsVisible="{Binding IsStep3}"
                       CornerRadius="16"
                       BackgroundColor="{StaticResource CardBackground}"
                       HasShadow="True"
                       Padding="20">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Household Photos" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryBlue}" />
                        <Button Text="📷 Capture Photo" Command="{Binding CapturePhotoCommand}" BackgroundColor="{StaticResource PrimaryBlue}" TextColor="White" />
                        <Image Source="{Binding CapturedImage}" HeightRequest="200" Aspect="AspectFill" Margin="0,10,0,0" IsVisible="{Binding HasImage}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- STEP 4: Services -->
                <Frame x:Name="Step4Frame"
                       IsVisible="{Binding IsStep4}"
                       CornerRadius="16"
                       BackgroundColor="{StaticResource CardBackground}"
                       HasShadow="True"
                       Padding="20">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Services and Utilities" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryBlue}" />
                        <Label Text="Select services your household uses:" />
                        <CheckBox IsChecked="{Binding HasElectricity}" />
                        <Label Text="Electricity" />
                        <CheckBox IsChecked="{Binding HasWater}" />
                        <Label Text="Water" />
                        <CheckBox IsChecked="{Binding HasInternet}" />
                        <Label Text="Internet" />
                    </VerticalStackLayout>
                </Frame>

                <!-- STEP 5: Review -->
                <Frame x:Name="Step5Frame"
                       IsVisible="{Binding IsStep5}"
                       CornerRadius="16"
                       BackgroundColor="{StaticResource CardBackground}"
                       HasShadow="True"
                       Padding="20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Review and Save" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryBlue}" />
                        <BoxView HeightRequest="1" BackgroundColor="#EEEEEE" Margin="0,4"/>

                        <Label Text="Head of Household" FontAttributes="Bold" />
                        <Label Text="{Binding HeadOfHouseholdName}" TextColor="Gray" />

                        <Label Text="ID Number" FontAttributes="Bold" />
                        <Label Text="{Binding HeadOfHouseholdIdNumber}" TextColor="Gray" />

                        <Label Text="Phone Number" FontAttributes="Bold" />
                        <Label Text="{Binding PhoneNumber}" TextColor="Gray" />

                        <Button Text="💾 Save Household"
                                Command="{Binding SubmitCommand}"
                                BackgroundColor="{StaticResource AccentGreen}"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="50"
                                Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation Buttons -->
        <Grid Grid.Row="2" Padding="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Text="⬅"
                    Command="{Binding PreviousCommand}"
                    IsEnabled="{Binding CanGoBack}"
                    BackgroundColor="{StaticResource DangerRed}"
                    TextColor="White"
                    CornerRadius="50"
                    WidthRequest="60"
                    HeightRequest="60"
                    Grid.Column="0"
                    HorizontalOptions="Start" />

            <Button Text="➡"
                    Command="{Binding NextCommand}"
                    BackgroundColor="{StaticResource PrimaryBlue}"
                    TextColor="White"
                    CornerRadius="50"
                    WidthRequest="60"
                    HeightRequest="60"
                    Grid.Column="1"
                    HorizontalOptions="End" />
        </Grid>
    </Grid>
</ContentPage>
