<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClientApp.Views.HouseholdDetailsPage"
             xmlns:vm="clr-namespace:ClientApp.Viewmodels"
             x:DataType="vm:HouseholdDetailViewModel"
             Title="HouseholdDetailsPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label Text="{Binding House_hold.HeadOfHouseholdName}" FontAttributes="Bold" FontSize="20"/>
            <Label Text="{Binding House_hold.Address}" FontSize="14"/>
            <Label Text="{Binding House_hold.NumberOfMembers, StringFormat='Members: {0}'}" FontSize="14"/>

            <Label Text="Members" FontAttributes="Bold" Margin="0,10,0,0"/>
            <CollectionView ItemsSource="{Binding House_hold.HouseholdMembers}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                    <!--    <Label Text="{Binding FullName}" /> -->
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Edit" Command="{Binding EditCommand}" Margin="0,20,0,0"
                    BackgroundColor="#2563eb" TextColor="White"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>